# ==============================================================================
# VeeCut AI Environment Configuration
# ==============================================================================

# HUGGINGFACE_TOKEN: Optional Hugging Face user access token (Personal Access Token).
# Allows higher rate limits on Hugging Face free serverless inference models
# (FLUX.1-schnell, SD-Turbo, Whisper v3 Turbo, Meta MMS-TTS, Meta NLLB-200, RMBG-1.4).
# If empty or not set, VeeCut operates with public free inference and 100% local browser AI.
# NEVER put private tokens into client-side JavaScript or HTML.
HUGGINGFACE_TOKEN=""
HUGGINGFACE_API_KEY=""

# GEMINI_API_KEY: Optional API key for Google Gemini, Google Veo, and DeepMind Lyria models.
# AI Studio automatically injects this at runtime when configured via Secrets.
# Marked as OPTIONAL PAID in VeeCut; never automatically charged.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, proxy routes, and streaming endpoints.
APP_URL="MY_APP_URL"

# Real-time Public Trending & Template Aggregation APIs
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Meta / Instagram Graph API Credentials for Reels & Creator Insights
META_APP_ID=""
META_APP_SECRET=""

# Additional Optional AI Provider Keys (Server-side Only)
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
REPLICATE_API_KEY=""
STABILITY_API_KEY=""
